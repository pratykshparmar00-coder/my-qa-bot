generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TestSuite {
  id        String   @id @default(cuid())
  suiteName String
  targetUrl String
  passed    Int
  failed    Int
  total     Int
  results   String
  createdAt DateTime @default(now())
}